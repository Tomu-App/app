{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "checkJs": false,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["$app/types", "node"]
  },
  "include": ["src", "test", "vite.config.ts"]
}
