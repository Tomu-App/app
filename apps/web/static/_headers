# Read by Workers static assets (wrangler.jsonc), not served itself.
# The main CSP is a <meta> tag that SvelteKit writes with script hashes (vite.config.ts).
# frame-ancestors only works as a header, so it lives here; both policies apply.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'none'

# Hashed file names: safe to cache forever.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
