{
	auto_https disable_certs
	# Spec: no IPs and no full URLs in logs. Error entries (e.g. a 502 during a restart) carry both.
	log {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>uri delete
				request>headers delete
				request>tls delete
				client_ip delete
			}
		}
	}
}

{$API_DOMAIN} {
	# Cloudflare origin certificate; Cloudflare terminates TLS for visitors.
	tls /certs/origin.pem /certs/origin-key.pem {
		# Authenticated Origin Pulls: only Cloudflare can connect, so cf-connecting-ip
		# (trusted by the app via TRUST_CLOUDFLARE=1) cannot be forged by direct access.
		client_auth {
			mode require_and_verify
			trust_pool file /certs/cloudflare-origin-pull-ca.pem
		}
	}
	reverse_proxy app:3000
}
